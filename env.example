# Copy this file to .env and fill in real values before running
# `docker compose up -d --build`. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=bazm
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=bazm

# --- API server ---
# Long random string used to sign session cookies. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-value

# Public URL of the deployed site (used to build OAuth redirect URLs, etc).
# e.g. https://bazm.uz
PUBLIC_APP_URL=

# --- Optional: Google sign-in (leave blank to disable) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: vendor/product photo uploads via Google Cloud Storage ---
# Needed for real vendors to upload their own photos in production.
# Not required for the seeded demo data, which uses static placeholder URLs.
#
# 1. Create a GCS bucket and a service account with Storage Object Admin on it.
# 2. PUBLIC_OBJECT_SEARCH_PATHS: comma-separated bucket-relative paths that
#    are served as public images, e.g. "/your-bucket-name/public"
# 3. PRIVATE_OBJECT_DIR: bucket-relative path for uploaded-but-not-yet-public
#    objects, e.g. "/your-bucket-name/private"
# 4. GCS_SERVICE_ACCOUNT_KEY_JSON: paste the full service account key JSON on
#    one line (e.g. `cat key.json | jq -c .` to compact it).
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
GCS_SERVICE_ACCOUNT_KEY_JSON=

# --- Web (nginx) ---
# Host port the site is served on. Put a reverse proxy / Certbot in front of
# this for HTTPS in production (see DEPLOY.md).
WEB_PORT=80
